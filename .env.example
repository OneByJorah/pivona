# =============================================================================
# pivona — Environment Configuration
# Copy to .env and edit for real deployments.
# This example is tuned for the local demo: no NET_ADMIN required.
# =============================================================================

# Flask environment
FLASK_ENV=production

# Timezone
TZ=UTC

# Demo mode: true = safe local preview with fake data, no network privileges.
# Set to false on a real Raspberry Pi gateway.
DEMO_MODE=true

# Database path (inside container, matches app.py default)
DB_PATH=/var/lib/pivona/traffic.db
